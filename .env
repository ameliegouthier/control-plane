# Database Connection Strings
# 
# IMPORTANT: Supabase uses connection pooling (PgBouncer) for runtime queries
# but requires DIRECT connections (port 5432) for migrations.
#
# Get these from Supabase Dashboard:
# 1. Go to Project Settings > Database
# 2. Connection string > Connection pooling: Use "DATABASE_URL" (port 6543)
# 3. Connection string > Direct connection: Use "DIRECT_URL" (port 5432)
#
# Both should include: ?sslmode=require

# Runtime connection (pooled via PgBouncer, port 6543)
# Use this for application queries
DATABASE_URL="postgresql://postgres.ntjcepfsoycpshdilaja:GAmelie09045*@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Direct connection (port 5432) - REQUIRED for migrations
# Use this for Prisma migrations (migrate dev/deploy)
DIRECT_URL="postgresql://postgres:GAmelie09045*@db.ntjcepfsoycpshdilaja.supabase.co:5432/postgres"

ENCRYPTION_SECRET="dev_secret_key"
# Demo mode (optional)
# DEMO_MODE=true
